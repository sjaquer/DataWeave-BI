
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de usuarios
    match /users/{userId} {
      // Los usuarios solo pueden leer su propia información
      allow read: if request.auth != null && request.auth.uid == userId;
      // Solo los administradores pueden escribir (crear usuarios desde el servidor)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para pedidos de Shopify
    match /shopify_orders/{orderId} {
      // Usuarios autenticados pueden leer todos los pedidos
      allow read: if request.auth != null;
      // Solo usuarios autenticados pueden escribir (las operaciones del servidor usan Admin SDK)
      allow write: if request.auth != null;
    }
    
    // Reglas para movimientos de inventario
    match /inventory_movements/{movementId} {
      // Usuarios autenticados pueden leer
      allow read: if request.auth != null;
      // Solo usuarios autenticados pueden escribir
      allow write: if request.auth != null;
    }

    // Regla de respaldo para cualquier otro documento.
    // Por defecto, denegar todo para mayor seguridad.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
;

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que los clientes (el dashboard en el navegador) lean
    // y los servidores (webhooks, cargas CSV) escriban en la colección de pedidos.
    match /shopify_orders/{orderId} {
      // Por ahora, permitimos la lectura y escritura para cualquier usuario autenticado.
      // Puedes restringir esto más en el futuro si es necesario.
      // Las escrituras desde el servidor (Admin SDK) bypassan estas reglas de todas formas.
      allow read, write: if request.auth != null; // Cambiado para seguridad básica
    }

    // Regla de respaldo para cualquier otro documento.
    // Por defecto, denegar todo para mayor seguridad.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
